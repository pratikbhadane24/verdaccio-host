# Verdaccio config - copy to .env (local) or paste into Coolify env UI.
# Every value optional - sane defaults baked into docker-compose.yaml.

# --- Network ---
VERDACCIO_PORT=4873

# Public URL used by UI/CLI install hints.
# Local:   http://localhost:4873
# Coolify: set to your domain (or use magic var: https://$SERVICE_FQDN_VERDACCIO_4873)
VERDACCIO_PUBLIC_URL=http://localhost:4873

# --- Image ---
VERDACCIO_VERSION=6
RESTART_POLICY=unless-stopped

# --- Branding ---
REGISTRY_TITLE=Tradinx Registry
REGISTRY_PRIMARY_COLOR=#4b5e40

# --- Auth ---
# Set to -1 after creating your users to lock signup
MAX_USERS=1000
BCRYPT_ROUNDS=12

# --- Packages ---
# Private scope (no leading slash). Patterns matched in order; private MUST precede catch-alls.
PRIVATE_SCOPE=@pratikbhadane24

# --- Uplink ---
UPLINK_NPMJS_URL=https://registry.npmjs.org/

# --- Reverse proxy IP/range trusted for X-Forwarded-* (set to proxy IP behind Coolify/nginx) ---
TRUST_PROXY=127.0.0.1
